<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Receiver SOLO en debug: captura la respuesta del RemoteInput de la
         notificación simulada y la muestra en Logcat. -->
    <application>
        <receiver
            android:name=".debug.DebugReplyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jjcampac.walink.debug.ACTION_RESPONDER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
